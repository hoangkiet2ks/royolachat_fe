<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cho phép tất cả certificate (chỉ dùng cho development/testing) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust system certificates -->
            <certificates src="system" />
            <!-- Trust user-added certificates (cho phép self-signed) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Cấu hình riêng cho domain backend -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">18.141.211.167.nip.io</domain>
        <domain includeSubdomains="true">18.141.211.167</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    
    <!-- Debug config - cho phép tất cả trong debug build -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
